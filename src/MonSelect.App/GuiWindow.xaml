<Window x:Class="MonSelect.App.GuiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MonSelect.App"
        x:ClassModifier="internal"
        Title="MonSelect" Width="1200" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0E1116" Foreground="#D6DCE4"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Window.Resources>
        <local:IndexPlusOneConverter x:Key="IndexPlusOne"/>
        <local:TailTruncateConverter x:Key="TailTruncate"/>

        <!--
            Los templates nativos de DataGrid/DataGridRow/DataGridCell (y de
            TextBox, ComboBox, etc.) pintan su estado de selección con estos
            SystemColors *BrushKey por default — normalmente texto blanco sobre
            el azul del tema de Windows. Sin pisarlos acá, seleccionar una fila
            deja texto claro sobre un highlight igual de claro: ilegible sobre
            esta paleta oscura. Se pisan una sola vez, a nivel de ventana, para
            que cubra cualquier control nativo que dependa de ellos — no sólo
            el DataGrid — en vez de perseguir cada control uno por uno.
        -->
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#33E8A33D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#D6DCE4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#2A313B"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#D6DCE4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#161B22"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#D6DCE4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#161B22"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D6DCE4"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#7C8899"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlLightBrushKey}" Color="#2A313B"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuHighlightBrushKey}" Color="#33E8A33D"/>
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#D6DCE4"/>

        <SolidColorBrush x:Key="Ink" Color="#0E1116"/>
        <SolidColorBrush x:Key="Panel" Color="#161B22"/>
        <SolidColorBrush x:Key="Line" Color="#2A313B"/>
        <SolidColorBrush x:Key="TextBrush" Color="#D6DCE4"/>
        <SolidColorBrush x:Key="Muted" Color="#7C8899"/>
        <SolidColorBrush x:Key="Accent" Color="#E8A33D"/>
        <SolidColorBrush x:Key="MatchBrush" Color="#5FBF8F"/>
        <SolidColorBrush x:Key="Alarm" Color="#D2635A"/>

        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}" Margin="0,0,2,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="False">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            La acción primaria de cada vista: viva en acento cuando se puede
            usar, y visiblemente inerte (panel/línea, sin acento) cuando no —
            nunca "acento débil", que lee igual de clickeable en las dos.
        -->
        <Style TargetType="Button" x:Key="AccentButton" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="Foreground" Value="#0E1116"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource Panel}"/>
                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
                    <Setter Property="FontWeight" Value="Normal"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{StaticResource Ink}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource Ink}"/>
            <Setter Property="AlternatingRowBackground" Value="{StaticResource Panel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource Line}"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Focusable" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"
                                BorderBrush="{StaticResource Accent}" BorderThickness="0">
                            <ContentPresenter VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Fila seleccionada y la grilla tiene foco: acento tenue, texto siempre claro. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#33E8A33D"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <!-- Fila seleccionada pero el foco se fue a otro control (p.ej. uno de los
                                 botones de acción): highlight más discreto, mismo texto legible. Sin esto,
                                 WPF usa el brush "inactive selection" del sistema — claro sobre claro. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{StaticResource Line}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </MultiTrigger>
                            <!-- Foco de teclado: contorno de 1px en el acento, distinto de la selección. -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <!-- Regla deshabilitada: se lee por PESO (texto atenuado), nunca por lavarse
                                 hasta ser invisible — el fondo de la fila no cambia por esto. Va al final
                                 para ganarle a los triggers de selección de arriba: una regla apagada se
                                 nota igual aunque esté seleccionada. -->
                            <DataTrigger Binding="{Binding Rule.Enabled}" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--
            Reemplaza el ControlTemplate por default de DataGridRow entero: el
            de fábrica pinta su propio hover/selección con brushes del tema de
            Windows por dentro de la plantilla (no vía la propiedad Background
            de la fila), así que un Setter o un Style.Trigger sobre Background
            no alcanza a cambiar nada — hay que reemplazar la plantilla.
        -->
        <Style TargetType="DataGridRow">
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridRow">
                        <Border x:Name="RowBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <DataGridCellsPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#14E8A33D"/>
                            </Trigger>
                            <!-- Seleccionada y la grilla tiene foco. -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="#33E8A33D"/>
                            </Trigger>
                            <!-- Seleccionada pero el foco se fue a otro control (uno de los botones de
                                 acción de la fila, típicamente): highlight más discreto, nunca el brush
                                 "inactive selection" del sistema. -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Line}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        </Style>
        <Style x:Key="MonoTruncatedExe" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="ToolTip" Value="{Binding ExePath}"/>
        </Style>
        <Style x:Key="MonoTruncatedCmd" TargetType="TextBlock" BasedOn="{StaticResource Mono}">
            <Setter Property="ToolTip" Value="{Binding CommandLine}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner de error de config: visible en ambas pestañas. El motor conserva las reglas anteriores,
             pero el usuario no tenía antes ninguna forma de saber que el archivo estaba roto. -->
        <Border x:Name="ErrorBanner" Grid.Row="0" Background="#241416" BorderBrush="{StaticResource Alarm}"
                BorderThickness="0,0,0,1" Padding="14,10" Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <TextBlock Text="rules.yaml no se pudo leer — se siguen usando las reglas anteriores, las que ves abajo."
                           Foreground="{StaticResource Alarm}" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource Alarm}" FontFamily="Cascadia Mono, Consolas"
                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="1" Margin="0" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="Ventanas abiertas">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1.15*" MinHeight="220"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*" MinHeight="160"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- La vista ya tiene su título en la pestaña; esta fila queda para
                         estado + la acción de refrescar, no para repetirlo. -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OpenWindowsStatus" Grid.Column="0" Style="{StaticResource Label}"
                                   VerticalAlignment="Center" FontSize="12"/>
                        <Button x:Name="OpenWindowsRefreshButton" Grid.Column="1" Content="Actualizar" Click="Refresh_Click"/>
                    </Grid>

                    <!-- El mapa a escala es la superficie principal de la vista: ocupa la
                         mitad superior y escala con la ventana. -->
                    <Border Grid.Row="1" Background="{StaticResource Ink}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1">
                        <Canvas x:Name="OpenWindowsMap" ClipToBounds="True" SizeChanged="OpenWindowsMap_SizeChanged"/>
                    </Border>

                    <!-- Título completo de la ventana seleccionada: el mapa no siempre tiene
                         lugar para mostrarlo entero adentro del rectángulo. -->
                    <TextBlock x:Name="SelectedWindowCaption" Grid.Row="2" Style="{StaticResource Label}"
                               FontSize="12" Margin="2,6,0,10" TextTrimming="CharacterEllipsis"/>

                    <DataGrid x:Name="OpenWindowsGrid" Grid.Row="3"
                              SelectionChanged="OpenWindowsGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="TÍTULO" Binding="{Binding Title}" Width="1.3*"/>
                            <DataGridTextColumn Header="PROCESO" Binding="{Binding Process}" Width="0.7*"/>
                            <DataGridTextColumn Header="EXE" Width="1.1*" ElementStyle="{StaticResource MonoTruncatedExe}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ExePath" Converter="{StaticResource TailTruncate}" ConverterParameter="40"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="CLASE" Binding="{Binding ClassName}" Width="0.75*"
                                                 ElementStyle="{StaticResource Mono}"/>
                            <DataGridTextColumn Header="COMMAND LINE" Width="1.1*" ElementStyle="{StaticResource MonoTruncatedCmd}">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="CommandLine" Converter="{StaticResource TailTruncate}" ConverterParameter="40"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="MONITOR" Binding="{Binding MonitorLabel}" Width="0.55*"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding StateLabel}" Width="0.55*"/>
                            <DataGridTextColumn Header="REGLA QUE MATCHEA" Binding="{Binding MatchedRule}" Width="0.9*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" Padding="12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="IncludeCmdlineCheck" Content="Incluir command line" Margin="0,0,18,0"/>
                            <CheckBox x:Name="IncludeTitleCheck" Content="Incluir título (regex)" Margin="0,0,18,0"/>
                            <Button x:Name="CreateRuleButton" Content="Capturar posición de esta ventana"
                                    Style="{StaticResource AccentButton}" Click="CreateRule_Click" IsEnabled="False"
                                    Margin="0,0,18,0"
                                    ToolTip="Acomodá la ventana a mano y confirmá: la regla se arma desde donde quede, no desde donde está ahora."/>
                            <TextBlock x:Name="OpenWindowsHint" Style="{StaticResource Label}"
                                       VerticalAlignment="Center"
                                       Text="Seleccioná una ventana, arriba en la tabla o en el mapa."/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Reglas">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- La vista ya tiene su título en la pestaña; esta fila queda para el
                         estado (cuántas reglas, cuántas activas) + refrescar. -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="RulesStatus" Style="{StaticResource Label}" FontSize="12"/>
                            <TextBlock Style="{StaticResource Label}" Margin="0,3,0,0"
                                       Text="El orden es la prioridad: gana la primera regla que matchea. Usá ↑/↓ para reordenar."/>
                        </StackPanel>
                        <Button x:Name="RulesRefreshButton" Grid.Column="1" Content="Actualizar" Click="Refresh_Click"/>
                    </Grid>

                    <!-- Alto = a su contenido, con techo: una lista de reglas real no tiene
                         cientos de filas, y así no deja un panel vacío debajo de 3 o 4. -->
                    <DataGrid x:Name="RulesGrid" Grid.Row="1" SelectionChanged="RulesGrid_SelectionChanged"
                              MouseDoubleClick="RulesGrid_MouseDoubleClick"
                              AlternationCount="1000" MaxHeight="440" VerticalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="#" Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow},
                                                   Path=(ItemsControl.AlternationIndex),
                                                   Converter={StaticResource IndexPlusOne}}"
                                                   Foreground="{StaticResource Muted}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="ON" Width="32">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Rule.Enabled, Mode=OneWay}"
                                                  HorizontalAlignment="Center" Click="ToggleRuleEnabled_Click"
                                                  ToolTip="Habilitar o deshabilitar esta regla"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="NOMBRE" Binding="{Binding Rule.Name}" Width="1*"/>
                            <DataGridTextColumn Header="MATCHEA" Binding="{Binding MatchSummary}" Width="1.5*"
                                                 ElementStyle="{StaticResource Mono}"/>
                            <DataGridTextColumn Header="DESTINO" Binding="{Binding Destination}" Width="0.85*"/>
                            <DataGridTextColumn Header="ESTADO" Binding="{Binding StateLabel}" Width="0.75*"/>
                            <!--
                                F: una regla muerta (título que cambió, exe que se movió) se ve acá
                                mismo, sin tener que reabrir la app para descubrirlo por NoMatch en
                                el log. 0 se resalta en rojo — MISMO chequeo en vivo que la columna
                                de RuleEditorDialog, contra las ventanas abiertas AHORA.
                            -->
                            <DataGridTemplateColumn Header="VENTANAS ABIERTAS QUE MATCHEAN" Width="0.9*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MatchCountLabel}" ToolTip="Ventanas abiertas ahora mismo cuyos criterios coinciden con esta regla.">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MatchBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MatchCount}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource Alarm}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="" Width="256">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="↑" Width="24" Padding="0" Margin="1,0" Click="MoveRuleUp_Click"
                                                    ToolTip="Subir prioridad"/>
                                            <Button Content="↓" Width="24" Padding="0" Margin="1,0" Click="MoveRuleDown_Click"
                                                    ToolTip="Bajar prioridad"/>
                                            <Button Content="Editar" Padding="6,2" Margin="1,0" Click="EditRule_Click"
                                                    ToolTip="Editar todos los campos de esta regla"/>
                                            <Button Content="Probar" Padding="6,2" Margin="1,0" Click="ApplyRule_Click"
                                                    ToolTip="Aplicar esta regla a las ventanas abiertas que matcheen"/>
                                            <Button Content="Eliminar" Padding="6,2" Margin="1,0" Click="DeleteRule_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock x:Name="RulesEmptyHint" Grid.Row="2" Style="{StaticResource Label}"
                               HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="14" Margin="0,20,0,0"
                               Text="Todavía no hay reglas. Andá a 'Ventanas abiertas', acomodá una ventana a mano y capturala con 'Crear regla desde esta ventana'."
                               TextWrapping="Wrap" MaxWidth="480" Visibility="Collapsed"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
