<Window x:Class="MonSelect.App.RuleEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Editar regla" Width="1040" Height="760" MinWidth="860" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#0E1116" Foreground="#D6DCE4"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#161B22"/>
        <SolidColorBrush x:Key="Line" Color="#2A313B"/>
        <SolidColorBrush x:Key="Accent" Color="#E8A33D"/>
        <SolidColorBrush x:Key="Muted" Color="#7C8899"/>
        <SolidColorBrush x:Key="Alarm" Color="#D2635A"/>
        <SolidColorBrush x:Key="MatchBrush" Color="#5FBF8F"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="#D6DCE4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="#D6DCE4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="#D6DCE4"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#D6DCE4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#D6DCE4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style x:Key="MatchRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- Columna izquierda: todos los campos de la regla. -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="NOMBRE" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                    <TextBox x:Name="NameBox" TextChanged="Field_Changed"/>

                    <CheckBox x:Name="EnabledCheck" Content="Regla habilitada" Margin="0,12,0,0"
                              Checked="Field_Changed" Unchecked="Field_Changed"/>

                    <TextBlock Text="CRITERIOS DE MATCH (se combinan con Y)" Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <CheckBox x:Name="ExeCheck" Content="Exe" Width="80" Click="Field_Changed"/>
                                <TextBox x:Name="ExeBox" Width="380" TextChanged="Field_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="CmdlineCheck" Content="Cmdline" Width="80" Click="Field_Changed"/>
                                <TextBox x:Name="CmdlineBox" Width="380" TextChanged="Field_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="ClassCheck" Content="Clase" Width="80" Click="Field_Changed"/>
                                <TextBox x:Name="ClassBox" Width="380" TextChanged="Field_Changed"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="TitleCheck" Content="Título" Width="80" Click="Field_Changed"/>
                                <TextBox x:Name="TitleBox" Width="380" TextChanged="Field_Changed"/>
                            </StackPanel>
                            <TextBlock Text="El título es un regex (.NET). Se ancla con ^ y $ para que no matchee de más."
                                       Style="{StaticResource FieldLabel}" Margin="84,2,0,0" FontSize="10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <CheckBox x:Name="AumidCheck" Content="AUMID" Width="80" Click="Field_Changed"/>
                                <TextBox x:Name="AumidBox" Width="380" TextChanged="Field_Changed"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="MONITOR DE DESTINO" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="MonitorsBox" TextChanged="Field_Changed"/>
                    <TextBlock x:Name="KnownAliasesText" Style="{StaticResource FieldLabel}" FontSize="10" Margin="0,3,0,0"
                               Text="Un alias, o varios separados por coma (en orden) si apply es rotate."/>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="220">
                            <TextBlock Text="ESTADO" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="StateCombo" SelectionChanged="State_Changed"/>
                        </StackPanel>
                        <StackPanel Width="220" Margin="16,0,0,0">
                            <TextBlock Text="SI EL MONITOR NO ESTÁ" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="IfMissingCombo" SelectionChanged="Field_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="220">
                            <TextBlock Text="CUÁNDO SE APLICA (varias ventanas)" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="ApplyCombo" SelectionChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Width="220" Margin="16,0,0,0">
                            <TextBlock Text="REINTENTOS (ms, separados por coma)" Style="{StaticResource FieldLabel}"/>
                            <TextBox x:Name="RetryBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="RECT (sólo si el estado es normal)" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="100" Margin="0,0,6,0">
                            <TextBlock Text="left" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="RectLeftBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="0,0,6,0">
                            <TextBlock Text="top" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="RectTopBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Width="100" Margin="0,0,6,0">
                            <TextBlock Text="right" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="RectRightBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                        <StackPanel Width="100">
                            <TextBlock Text="bottom" Style="{StaticResource FieldLabel}" Margin="0,0,0,2"/>
                            <TextBox x:Name="RectBottomBox" TextChanged="Field_Changed"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="BORDE PROPIO DE LA APP (bleed)" Style="{StaticResource FieldLabel}"/>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="10">
                        <StackPanel>
                            <RadioButton x:Name="BleedAutoRadio" GroupName="Bleed"
                                         Content="Automático — MonSelect mide si la app dibuja su propio borde"
                                         Checked="Field_Changed"/>
                            <RadioButton x:Name="BleedNeverRadio" GroupName="Bleed"
                                         Content="Nunca — la app no dibuja borde propio, no compensar"
                                         Checked="Field_Changed"/>
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="BleedFixedRadio" GroupName="Bleed" Content="Fijo:" Checked="Field_Changed"/>
                                <TextBox x:Name="BleedFixedBox" Width="60" Margin="6,0,0,0" TextChanged="Field_Changed"/>
                                <TextBlock Text="px" VerticalAlignment="Center" Margin="4,0,0,0" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                            <TextBlock x:Name="BleedMeasuredText" Style="{StaticResource FieldLabel}" Margin="0,8,0,0" FontSize="11"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Columna derecha: qué matchea ahora mismo + errores + vista previa YAML. -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.1*" MinHeight="140"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="0.9*" MinHeight="90"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="140"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="VENTANAS ABIERTAS QUE MATCHEAN AHORA" Style="{StaticResource FieldLabel}" Margin="0,0,0,3"/>
                <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="MatchesPanel" Margin="8"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="2" x:Name="ErrorsHeader" Text="PROBLEMAS" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"
                           Visibility="Collapsed"/>
                <Border Grid.Row="3" x:Name="ErrorsBorder" Background="#241416" BorderBrush="{StaticResource Alarm}"
                        BorderThickness="1" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ErrorsPanel" Margin="8"/>
                    </ScrollViewer>
                </Border>

                <TextBlock Grid.Row="4" Text="LO QUE VA A QUEDAR EN RULES.YAML" Style="{StaticResource FieldLabel}" Margin="0,10,0,3"/>
                <Border Grid.Row="5" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10">
                        <TextBlock x:Name="YamlPreview" FontFamily="Cascadia Mono, Consolas" FontSize="11.5"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="Cancel_Click"/>
            <Button x:Name="SaveButton" Content="Guardar cambios" Click="Save_Click"
                    Background="{StaticResource Accent}" Foreground="#0E1116" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
