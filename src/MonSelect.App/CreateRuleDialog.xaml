<Window x:Class="MonSelect.App.CreateRuleDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Crear regla desde esta ventana" Width="640" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0E1116" Foreground="#D6DCE4"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#161B22"/>
        <SolidColorBrush x:Key="Line" Color="#2A313B"/>
        <SolidColorBrush x:Key="Accent" Color="#E8A33D"/>
        <SolidColorBrush x:Key="Muted" Color="#7C8899"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="#D6DCE4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Panel}"/>
            <Setter Property="Foreground" Value="#D6DCE4"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="Padding" Value="7,5"/>
            <Setter Property="CaretBrush" Value="{StaticResource Accent}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="16" FontWeight="SemiBold"
                    Text="Crear regla desde esta ventana" Margin="0,0,0,4"/>
        <TextBlock Grid.Row="0" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="11"
                    Foreground="{StaticResource Muted}" Margin="0,26,0,14"
                    Text="Reproduce la ventana exactamente donde está ahora: mismo monitor, mismo estado, mismo rect visible."/>

        <StackPanel Grid.Row="1" Margin="0,20,0,10">
            <TextBlock Text="NOMBRE DE LA REGLA" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="NameBox" TextChanged="NameBox_TextChanged" FontSize="14"/>
        </StackPanel>

        <!--
            Sólo visible si se tildó "Incluir título (regex)" en la pestaña. El
            valor por defecto es la parte estable del título (WindowToRule.
            DefaultTitleRegex) — no el título entero, no anclado — y es
            editable: el usuario puede afinarlo antes de guardar en vez de
            depender de RuleEditorDialog para arreglarlo después.
        -->
        <StackPanel x:Name="TitleFieldPanel" Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="TÍTULO (SUBSTRING/REGEX, SIN ANCLAR)" FontSize="11"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="TitleBox" TextChanged="TitleBox_TextChanged" FontSize="13"/>
            <TextBlock x:Name="TitleHint" FontSize="11" Foreground="{StaticResource Muted}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!--
            Sólo visible si se tildó "Incluir command line". El valor por
            defecto son sólo los argumentos (WindowToRule.ArgumentsOnly) — no
            el ejecutable completo entre comillas, que ya está en match.exe.
        -->
        <StackPanel x:Name="CmdlineFieldPanel" Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Text="ARGUMENTOS DE LÍNEA DE COMANDO" FontSize="11"
                       Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
            <TextBox x:Name="CmdlineBox" TextChanged="CmdlineBox_TextChanged" FontSize="13"/>
            <TextBlock x:Name="CmdlineHint" FontSize="11" Foreground="{StaticResource Muted}"
                       Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,0">
            <TextBlock Text="LO QUE SE VA A ESCRIBIR EN RULES.YAML" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
            <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="12" MaxHeight="240">
                    <TextBlock x:Name="YamlPreview" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               Foreground="#D6DCE4"/>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="Cancel_Click"/>
            <Button Content="Guardar regla" Click="Save_Click"
                    Background="{StaticResource Accent}" Foreground="#0E1116" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
